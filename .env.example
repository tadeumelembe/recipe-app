# Copy to .env and fill in from the Firebase console (Project settings → General → Your apps).
# EXPO_PUBLIC_* values are inlined into the JS bundle at build time. Firebase web
# config is not secret, but never put server-side secrets behind this prefix.
EXPO_PUBLIC_FIREBASE_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
